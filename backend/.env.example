PORT=4000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-jwt-secret

# Apple DeviceCheck — server-only welcome grant protection
APPLE_DEVICECHECK_KEY_ID=your-devicecheck-key-id
APPLE_DEVICECHECK_TEAM_ID=your-apple-developer-team-id
APPLE_DEVICECHECK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Use development only with Debug/sandbox DeviceCheck tokens.
APPLE_DEVICECHECK_ENVIRONMENT=production

# Apple In-App Purchase verification
# Download Apple Root CA certificates separately, store them outside version control,
# and provide their comma-separated absolute paths here.
APPLE_IAP_BUNDLE_ID=com.inseong.coordit
APPLE_IAP_APPLE_ID=
APPLE_IAP_ROOT_CERTIFICATE_PATHS=
# Leave false until App Store Connect, StoreKit, and backend settlement are production-ready.
APPLE_IAP_ENABLED=false

# AdMob rewarded-ad server-side verification (only when rewards are enabled)
# Leave false until AdMob SSV validation and backend settlement are production-ready.
ADMOB_REWARDED_ENABLED=false
# Non-secret signed-callback marker; validation requests never grant a reward.
ADMOB_SSV_VALIDATION_CUSTOM_DATA=coordit-admob-ssv-validation-v1
ADMOB_REWARDED_AD_UNIT_ID=
ADMOB_REWARD_ITEM=
ADMOB_REWARD_AMOUNT=

# Anthropic (Claude) — for AI styling generation
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — Fit Lab report generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_MS=20000

# Product URL import
CRAWL_TIMEOUT_MS=30000
PAGE_LOAD_TIMEOUT_MS=20000
MAX_CONCURRENT_PAGES=2
MAX_REDIRECTS=5
MAX_JSON_RESPONSE_BYTES=2000000
MAX_HTML_BYTES=5000000
MAX_IMAGES=30
DOMAIN_REQUEST_DELAY_MS=1500
USER_RATE_LIMIT_PER_MINUTE=5
USER_AGENT=CoorditProductImporter/1.0
